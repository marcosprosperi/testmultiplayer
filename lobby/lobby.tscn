color = Color(1, 0.6, 0.3, 1)

[node name="SortButton" type="Button" parent="LevelsPanel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Los elegidos, de fácil a difícil"
text = "Por dificultad"
script = ExtResource("2_cartoon")
