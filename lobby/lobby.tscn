[gd_scene format=3]

[ext_resource type="Script" path="res://lobby/lobby.gd" id="1_lobby"]
[ext_resource type="Script" path="res://ui/cartoon_button.gd" id="2_cartoon"]
[ext_resource type="FontFile" path="res://ui/fonts/LilitaOne-Regular.ttf" id="3_title_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_levels"]
bg_color = Color(0.24, 0.17, 0.37, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.17, 0.11, 0.23, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="Lobby" type="CanvasLayer"]
layer = 10
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.11, 0.07, 0.18, 0.94)

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Panel/Margin/VBox/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Sala de espera"

[node name="GameNameEdit" type="LineEdit" parent="Panel/Margin/VBox/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Nombre de la partida (lo ven todos en la lista de partidas)"

[node name="AddressRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="AddressLabel" type="Label" parent="Panel/Margin/VBox/AddressRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "Compartí tu IP"

[node name="CopyButton" type="Button" parent="Panel/Margin/VBox/AddressRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Copiar IP"

[node name="HSeparator" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="Columns" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="Profile" type="VBoxContainer" parent="Panel/Margin/VBox/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="NameTitle" type="Label" parent="Panel/Margin/VBox/Columns/Profile"]
layout_mode = 2
text = "Tu nombre"

[node name="NameEdit" type="LineEdit" parent="Panel/Margin/VBox/Columns/Profile"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Escribí tu nombre"

[node name="ColorTitle" type="Label" parent="Panel/Margin/VBox/Columns/Profile"]
layout_mode = 2
text = "Tu color"

[node name="ColorsBox" type="HBoxContainer" parent="Panel/Margin/VBox/Columns/Profile"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="ConfirmButton" type="Button" parent="Panel/Margin/VBox/Columns/Profile"]
unique_name_in_owner = true
layout_mode = 2
text = "Listo"

[node name="StatusLabel" type="Label" parent="Panel/Margin/VBox/Columns/Profile"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="VSeparator" type="VSeparator" parent="Panel/Margin/VBox/Columns"]
layout_mode = 2

[node name="Players" type="VBoxContainer" parent="Panel/Margin/VBox/Columns"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2

[node name="PlayersTitle" type="Label" parent="Panel/Margin/VBox/Columns/Players"]
unique_name_in_owner = true
layout_mode = 2
text = "Jugadores"

[node name="PlayersList" type="VBoxContainer" parent="Panel/Margin/VBox/Columns/Players"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="PlaylistLabel" type="Label" parent="Panel/Margin/VBox/Columns/Players"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
modulate = Color(1, 1, 1, 0.75)
autowrap_mode = 3

[node name="Options" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="CoinsCheck" type="CheckButton" parent="Panel/Margin/VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Cada moneda suma 1 punto al terminar la carrera, pero te hace más lento"
button_pressed = true
text = "Monedas"

[node name="CheckpointsCheck" type="CheckButton" parent="Panel/Margin/VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Al perder volvés a la última bandera que tocaste en vez de al principio"
text = "Checkpoints"

[node name="BotsCheck" type="CheckButton" parent="Panel/Margin/VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Completa la carrera con bots hasta 8 jugadores. Si entra alguien, un bot le deja su lugar"
text = "Bots"

[node name="LevelsButton" type="Button" parent="Panel/Margin/VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Niveles…"

[node name="Buttons" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="LeaveButton" type="Button" parent="Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Salir"
script = ExtResource("2_cartoon")
color = Color(1, 0.42, 0.42, 1)

[node name="OptionsButton" type="Button" parent="Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Pantalla, sonido y controles (también con Esc)"
text = "Opciones"
script = ExtResource("2_cartoon")
color = Color(0.67, 0.5, 0.95, 1)

[node name="Spacer" type="Control" parent="Panel/Margin/VBox/Buttons"]
layout_mode = 2
size_flags_horizontal = 3

[node name="StartButton" type="Button" parent="Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Empezar carrera"
script = ExtResource("2_cartoon")
color = Color(0.45, 0.88, 0.5, 1)

[node name="LevelsDim" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.04, 0.12, 0.6)

[node name="LevelsPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -222.0
offset_top = -128.0
offset_right = 222.0
offset_bottom = 128.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_levels")

[node name="Margin" type="MarginContainer" parent="LevelsPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="LevelsPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="LevelsPanel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.25, 1)
theme_override_colors/font_outline_color = Color(0.17, 0.11, 0.23, 1)
theme_override_constants/outline_size = 6
theme_override_fonts/font = ExtResource("3_title_font")
theme_override_font_sizes/font_size = 18
text = "¿Qué niveles jugamos?"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="LevelsPanel/Margin/VBox"]
modulate = Color(1, 1, 1, 0.7)
layout_mode = 2
theme_override_font_sizes/font_size = 8
text = "Tocá un nivel para sumarlo o sacarlo; el número es el orden en que se juegan"
horizontal_alignment = 1

[node name="LevelCards" type="GridContainer" parent="LevelsPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 3
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 3

[node name="Buttons" type="HBoxContainer" parent="LevelsPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="AllButton" type="Button" parent="LevelsPanel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Todos los niveles, de fácil a difícil"
text = "Todos"
script = ExtResource("2_cartoon")
color = Color(0.35, 0.78, 0.98, 1)

[node name="ShuffleButton" type="Button" parent="LevelsPanel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
